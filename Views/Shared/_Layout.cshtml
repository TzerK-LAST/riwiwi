<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mi App</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 font-sans">

    <div class="flex h-screen">

        <!-- Overlay oscuro al abrir el menú en móvil -->
        <div id="overlay"
             class="fixed inset-0 bg-black bg-opacity-50 z-20 hidden lg:hidden"
             onclick="toggleMenu()">
        </div>

        <!-- Sidebar -->
        <aside id="sidebar"
               class="fixed lg:static z-30 top-0 left-0 min-h-screen
                      w-64 bg-violet-800 text-white flex flex-col
                      -translate-x-full lg:translate-x-0 transition-transform duration-300">

            <!-- Logo -->
            <div class="px-6 py-5 border-b border-violet-700 flex items-center justify-between">
                <h1 class="text-xl font-bold tracking-wide">animeflv event</h1>
                <button onclick="toggleMenu()" class="lg:hidden text-violet-200 hover:text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <!-- Navbar -->
            <nav class="flex-1 px-4 py-6 space-y-1">

                <a href="/Dashboard"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm text-violet-100 hover:bg-violet-700 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                    </svg>
                    Dashboard
                </a>
                

            </nav>

            <!-- Footer sidebar -->
            <div class="px-6 py-4 border-t border-violet-700 text-xs text-violet-300">
                otaku progress...
            </div>

        </aside>

        <!-- Contenido principal -->
        <div class="flex-1 flex flex-col min-w-0 overflow-auto">

            <header class="bg-white shadow px-4 sm:px-8 py-4 flex items-center gap-4">
                <button onclick="toggleMenu()"
                        class="lg:hidden text-gray-500 hover:text-gray-700">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
                <h2 class="text-lg font-semibold text-gray-700">@ViewData["Title"]</h2>
            </header>

            <main class="flex-1 p-4 sm:p-8">

                @if (TempData["Exito"] != null)
                {
                    <div class="mb-4 bg-green-100 text-green-800 border border-green-300 rounded-lg px-4 py-3">
                         @TempData["Exito"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="mb-4 bg-red-100 text-red-800 border border-red-300 rounded-lg px-4 py-3">
                         @TempData["Error"]
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script>
        function toggleMenu() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('overlay');
            sidebar.classList.toggle('-translate-x-full');
            overlay.classList.toggle('hidden');
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>